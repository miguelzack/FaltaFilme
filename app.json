{
  "expo": {
    "name": "FaltaFilme",
    "slug": "faltaFilme",
    "scheme": "faltafilme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/faltafilme-icon.png",
    "splash": {
      "image": "./assets/faltafilme-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07002F"
    },
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      ["expo-navigation-bar", {"hidden": true}]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.faltafilme.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#07002F",
        "foregroundImage": "./assets/faltafilme-adaptive-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "46f537d8-a455-44b4-a2d1-ca948b0f16e3"
      }
    }
  }
}
